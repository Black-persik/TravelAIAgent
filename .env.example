# Copy this file to .env and fill in the values locally.
# .env is gitignored and must never be committed. Keep only variable names here.
# Production values live in GitHub: Settings -> Environments -> production,
# as Secrets or Variables (marked below). Empty values fall back to defaults.
# Comments go on their own lines: some tools treat "VALUE # comment" as the value.

# --- LLM provider (OpenRouter) ---
# Secret
OPENROUTER_API_KEY=
# Variables: model ids from https://openrouter.ai/models (pick models with tool calling).
# FAST is a cheap model for extraction (used from stage 3), SMART answers and plans.
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# --- Tracing (Langfuse), optional: leave the keys empty to turn tracing off ---
# Secrets
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Variable, default https://cloud.langfuse.com
LANGFUSE_HOST=

# --- Database (Postgres + pgvector); the connection URL is built from these ---
# Variables
POSTGRES_USER=
POSTGRES_DB=
# Secret, generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Only when running the app without Docker while the database runs in Docker:
# POSTGRES_HOST=localhost

# --- Access to the web UI ---
# Variable
APP_USERNAME=
# Secrets, generate with: openssl rand -hex 16 (password), openssl rand -hex 32 (session)
APP_PASSWORD=
SESSION_SECRET=
