# Copy this file to .env and fill in the values locally.
# .env is gitignored and must never be committed. Keep only variable names here.

# LLM provider (OpenRouter)
OPENROUTER_API_KEY=

# Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Database (Postgres + pgvector)
DATABASE_URL=

# Access to the web UI
APP_USERNAME=
APP_PASSWORD=
